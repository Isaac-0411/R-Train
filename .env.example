# Copy this file to .env and adjust the values.
# Every variable is optional, the defaults work for a local installation.

# --- server ---------------------------------------------------------------

# Address the server listens on.
ADDR=:8080

# Path of the SQLite database file. The directory is created automatically.
DB_PATH=data/app.db

# Idle timeout of a login session: the user is signed out after this long
# without a request. Every request starts the clock again.
# Examples: 30m, 2h, 24h, 168h (7 days).
SESSION_TTL=30m

# Name of the session cookie.
SESSION_COOKIE_NAME=rt_session

# Set to true when the site is served over HTTPS. The cookie is then only
# sent over an encrypted connection.
COOKIE_SECURE=false

# Public base URL of the site, e.g. https://reading.example.com
BASE_URL=

# debug | info | warn | error
LOG_LEVEL=info

# Relaxes the content security policy for local development.
DEV_MODE=false

# --- first administrator --------------------------------------------------

# These two values bootstrap the main (absolute) administrator the first
# time the server starts on an empty database. They are ignored as soon as
# a main administrator exists, so restarting the server never overwrites
# an account.
#
# Leave them empty and use the adminctl command instead:
#   go run ./cmd/adminctl create-admin --username root --password '...'
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator
